{
  "manifest_version": 3,
  "name": "Gut gesagt",
  "version": "0.1.0",
  "description": "Markierten Text per Rechtsklick in Gut gesagt suchen oder einwerfen.",
  "minimum_chrome_version": "121",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "hintergrund.js",
    "scripts": ["adressen.js", "hintergrund.js"]
  },
  "options_ui": {
    "page": "optionen.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gutgesagt@netzbegruenung.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
