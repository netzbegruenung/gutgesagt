# Local Development Environment Configuration
# Copy this file to .env and adjust values as needed

# Environment type - set to false for local development
DOCKER_CONTAINER=false

# Database configuration
SEMANTIC_SEARCH_PGVECTOR_URL=postgresql+psycopg2://semantic_search:changeme@localhost:5432/semantic_search
APP_DATABASE_URL=postgresql+psycopg2://app_user:changeme@localhost:5433/gutgesagt_app

# Path configuration for local development
# These paths are relative to the project root
SEMANTIC_SEARCH_DATA_PATH=./data/seed/v1.0
SEMANTIC_SEARCH_METADATA_PATH=./temp_data/metadata

# Torch-Threads fuer Einbettungen (#480); ohne Angabe einer je sichtbarem Kern.
# Begrenzt auf einem ausgelasteten Host das gegenseitige Ausbremsen. Nicht leer setzen.
# SEMANTIC_SEARCH_EMBEDDING_THREADS=2

# Logging configuration
SEMANTIC_SEARCH_LOG_LEVEL=INFO
SEMANTIC_SEARCH_LOG_FILE=

# Admin users (comma-separated list of user IDs)
SEMANTIC_SEARCH_ADMIN_USERS=

# Startkonten (comma-separated user IDs of Beta-Zugaenge, #352): their usage is
# not counted, their votes count nowhere, they collect no points, and they show their
# full name. Set STARTKONTEN of the BFF to the same value, otherwise the full name is
# silently missing (docs/ARCHITECTURE.md).
SEMANTIC_SEARCH_STARTKONTEN=

# Points (ADR 0004, #352). Off by default. ONLY SWITCH ON AFTER #668 IS MERGED: points and
# milestones need their own voluntary consent "Punkte und Meilensteine" (not the Art. 9
# consent since wording 2026-11-13); until then the service refuses to start with it on.
# Weights and daily caps: see core/config.py (SEMANTIC_SEARCH_PUNKTE_*).
SEMANTIC_SEARCH_PUNKTE_AKTIV=false
# Milestone badges next to the display name for other signed-in people (#351). Off by
# default and only effective together with PUNKTE_AKTIV; each person must also agree to
# the visibility. Switch on only after the DSFA (docs/DSFA.md, V22) and the privacy policy.
SEMANTIC_SEARCH_ABZEICHEN_SICHTBAR_AKTIV=false
# "Ja, gepostet" after copying (#643): signed-in people with Art. 9 consent report that
# they posted a reply; counted once per person and calendar week, without the Beitrag.
# Off by default; switch on only after the DSFA and the privacy policy name it.
SEMANTIC_SEARCH_GEPOSTET_AKTIV=false
# "Ja, gepostet" without an account (#799): only a weekly count "Meldungen ohne Konto", no
# check value, no address, separate from the people counted with an account. Off by default,
# works only with SEMANTIC_SEARCH_GEPOSTET_AKTIV; switch on only after the privacy policy
# paragraph and the DSFA addendum (legal review).
SEMANTIC_SEARCH_GEPOSTET_OHNE_KONTO_AKTIV=false
# Herkunft pruefen (#759): upper bound; on by default because no personal data is involved.
# Effective only after an admin switches it on (Admin, Schalter). Fetches the links of all
# Herkuenfte at night (outbound HTTP to arbitrary hosts) and lists dead or moved ones.
SEMANTIC_SEARCH_HERKUNFT_PRUEFEN_AKTIV=true
# Upper bound of app shortcuts in the manifest (#757): on by default, off until an admin
# switches them on (Admin, "Schalter"); off, every shortcut opens the start page.
SEMANTIC_SEARCH_ABKUERZUNGEN_AKTIV=true
# New answers to one's own Aussagen (#760): upper bound, off by default. Nothing is stored,
# but switch on only after the privacy policy names the third 7-day number.
SEMANTIC_SEARCH_ANTWORTEN_HINWEIS_AKTIV=false
# Upper bounds of switches that transfer nothing (#756): on by default, the function is
# off until an admin switches it on (Admin, "Schalter"). Share as image draws in the browser.
SEMANTIC_SEARCH_SHAREPIC_AKTIV=true
# Growth next to the Bestandszahl on the start page (new Kommentare of the last 7 days): counts
# only public content when asked, stores nothing.
SEMANTIC_SEARCH_BESTANDSZAHL_ZUWACHS_AKTIV=true
# Box "Kurz gesagt" at the top of the privacy policy: upper bound, off by default until the
# legal wording is in the frontend; without it the box stays hidden even when switched on.
SEMANTIC_SEARCH_DSE_KURZFASSUNG_AKTIV=false
# Teams over invitations: upper bound, off by default (membership needs its own consent,
# DSFA addendum and privacy policy section first).
SEMANTIC_SEARCH_TEAMS_AKTIV=false
# Team progress and team quests (#784, #792): own upper bounds, off until DSFA addendum
# V29 and the legal OK; progress works only with teams, quests only with progress.
SEMANTIC_SEARCH_TEAM_FORTSCHRITT_AKTIV=false
SEMANTIC_SEARCH_TEAM_QUESTS_AKTIV=false
# Teams shown publicly at the name: own upper bound, off until the data protection officer
# has advised; works only together with SEMANTIC_SEARCH_TEAMS_AKTIV.
SEMANTIC_SEARCH_TEAMS_OEFFENTLICH_AKTIV=false
# Trust sentence when joining a team via a team link: text only, stores nothing; off until
# legal has checked what team members see of each other. Works only with teams.
SEMANTIC_SEARCH_TEAMLINK_VERTRAUENSSATZ_AKTIV=false
# Button "Was hat dich gestört?" for the launch phase: upper bound, off by default; switch
# on only with the privacy policy paragraph (legal package 27.11.). From 31.12.2026 it no
# longer takes entries, and the feedback cleanup deletes all of them.
SEMANTIC_SEARCH_FEEDBACK_GESTOERT_AKTIV=false
# Spielgefuehl building blocks (#782 to #793): upper bounds, off by default; conditions for
# switching on per switch in docs/ARCHITECTURE.md ("Schalter fuer das Spielgefuehl").
SEMANTIC_SEARCH_SAISON_ZIEL_AKTIV=false
SEMANTIC_SEARCH_GARTENANSICHT_AKTIV=false
SEMANTIC_SEARCH_KOPIERT_ERFOLG_AKTIV=false
SEMANTIC_SEARCH_KONTER_PROBE_AKTIV=false
SEMANTIC_SEARCH_LUECKE_ZU_GROSS_AKTIV=false
SEMANTIC_SEARCH_EINWILLIGUNG_IM_GEWINN_AKTIV=false
SEMANTIC_SEARCH_NAECHSTER_SCHRITT_AKTIV=false
SEMANTIC_SEARCH_WIRKUNGS_ECHO_AKTIV=false
SEMANTIC_SEARCH_DANKE_KNOPF_AKTIV=false
SEMANTIC_SEARCH_DANKE_OHNE_KONTO_AKTIV=false
SEMANTIC_SEARCH_RANGLISTE_AKTIV=false
# Trust line above the login options (preliminary legal assessment 26.11.): text only,
# off by default until the assessment is final; condition on the admin page.
SEMANTIC_SEARCH_VERTRAUENSZEILE_AKTIV=false
# Short hint line under the search button ("Ohne Namen gespeichert · Datenschutz"): upper
# bound, off until the legal OK on the short wording.
SEMANTIC_SEARCH_HINWEISZEILE_KURZ_AKTIV=false

# "Diese Woche oft genutzt": entdoppelte Nutzungen (per person and day) a Beitrag needs in
# seven days (at least 2), and how many such Beitraege before the section appears (1 to 5).
# Defaults suit the start phase; raise them once usage grows.
SEMANTIC_SEARCH_OFT_GENUTZT_MINDEST_NUTZUNGEN=2
SEMANTIC_SEARCH_OFT_GENUTZT_MINDEST_BEITRAEGE=2

# Rate limit of POST /usage/content/{id}/usage (#352): copies per person (visitors:
# per address) within the window.
SEMANTIC_SEARCH_NUTZUNG_RATE_LIMIT_ANFRAGEN=60
SEMANTIC_SEARCH_NUTZUNG_RATE_LIMIT_MINUTEN=10

# Tagesdeckel: new Beitraege, Aussagen and Einwuerfe per person and UTC day. Admins and
# Startkonten are exempt. Above it the service answers 429 with error TAGESDECKEL.
SEMANTIC_SEARCH_TAGESDECKEL_BEITRAEGE=20

# Rate limit per person on the creating routes (per minute / per hour). Startkonten are
# exempt (import of the Startbestand), admins are not.
SEMANTIC_SEARCH_ANLEGE_RATE_LIMIT_JE_MINUTE=10
SEMANTIC_SEARCH_ANLEGE_RATE_LIMIT_JE_STUNDE=100

# Requests per window of the rate limits without login, counted per address. In a venue
# WLAN everybody shares one address; raise them there. The windows are fixed (the privacy
# policy names the periods that follow from them).
# Similar Aussagen under "Nicht dabei?" (10 min)
SEMANTIC_SEARCH_AEHNLICHE_AUSSAGEN_RATE_LIMIT_ANFRAGEN=60
# New Aussagen from search queries (10 min)
SEMANTIC_SEARCH_SUCHAUSSAGE_RATE_LIMIT_ANFRAGEN=60
# Feedback (15 min)
SEMANTIC_SEARCH_FEEDBACK_RATE_LIMIT_ANFRAGEN=5
# Meldungen of Beitraege (15 min)
SEMANTIC_SEARCH_MELDUNG_RATE_LIMIT_ANFRAGEN=5
# Redeeming an Einladung (15 min)
SEMANTIC_SEARCH_EINLADUNG_RATE_LIMIT_ANFRAGEN=30
# Checking an Einladung (15 min)
SEMANTIC_SEARCH_EINLADUNG_PRUEFEN_RATE_LIMIT_ANFRAGEN=60
# Joining a Team while logged in, per person, not per address (15 min)
SEMANTIC_SEARCH_TEAM_BEITRETEN_RATE_LIMIT_ANFRAGEN=20

# Einladungen einloesen (#429): Konten im Realm von Gut gesagt anlegen.
# Ohne URL, Client und Secret lassen sich Einladungen nur verwalten. docs/KEYCLOAK_REALM.md
# Erst zusammen mit dem Wechsel der BFF auf den neuen Realm setzen (Reihenfolge dort).
SEMANTIC_SEARCH_KEYCLOAK_URL=
SEMANTIC_SEARCH_KEYCLOAK_REALM=gutgesagt
SEMANTIC_SEARCH_KEYCLOAK_ADMIN_CLIENT_ID=
SEMANTIC_SEARCH_KEYCLOAK_ADMIN_CLIENT_SECRET=
SEMANTIC_SEARCH_KEYCLOAK_APP_CLIENT_ID=
SEMANTIC_SEARCH_APP_URL=

# Der taegliche Bereinigungsjob (Frist der Nutzungsereignisse); frueher ENABLE_USAGE_CLEANUP, das gilt weiter.
# Suchereignisse werden am Tagesende verdichtet, unabhaengig von diesem Schalter (#495).
SEMANTIC_SEARCH_ENABLE_BEREINIGUNGSJOB=true
SEMANTIC_SEARCH_USAGE_RETENTION_DAYS=90
